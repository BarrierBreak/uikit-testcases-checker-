import Foundation

{
  "tests": [
    {
      "id": "button_not_interactable",
      "description": "Button is not user-interactable",
      "view": {
        "type": "UIButton",
        "title": "Pay",
        "userInteractionEnabled": false
      },
      "expectedTechnique": "BB40501"
    },
    {
      "id": "missing_accessible_name",
      "description": "Button missing accessible name",
      "view": {
        "type": "UIButton",
        "isAccessibilityElement": true
      },
      "expectedTechnique": "BB40503"
    },
    {
      "id": "image_button_without_label",
      "description": "Image-only button missing label",
      "view": {
        "type": "UIButton",
        "image": true,
        "isAccessibilityElement": true
      },
      "expectedTechnique": "BB40504"
    }
  ]
}
